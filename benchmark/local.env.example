# Site configuration for bench.sbatch. Copy to `local.env`, which is untracked:
#
#   cp benchmark/local.env.example benchmark/local.env
#   . benchmark/local.env && sbatch benchmark/bench.sbatch
#
# Sourcing before `sbatch` matters for the SBATCH_* entries: those are read by
# sbatch itself at submit time and cannot be set from inside the job. The rest
# are picked up either way, since bench.sbatch also sources this file if present.

# Partition to submit to, and the node to pin to. Pinning to one node is a
# measurement requirement, not a convenience: wall-clock is not comparable
# across nodes, and summarize.py refuses to tabulate records that span hosts.
export SBATCH_PARTITION="${SBATCH_PARTITION:-}"
export SBATCH_NODELIST="${SBATCH_NODELIST:-}"

# Directory holding <corpus>.bin for each of dolmasample, arxiv, github, c4.
export CORPUS_ROOT="${CORPUS_ROOT:-/scratch/${USER:-$(id -un)}/corpora}"

# Module names to load inside the job, space separated. Leave empty if the
# toolchain is already on PATH. A module-provided libgomp or libstdc++ lives
# outside the default loader path, so omitting a needed one shows up as a
# runtime linker failure after a clean build, not as a build error.
export MODULES="${MODULES-}"

# Held back from the RLIMIT_AS the CPU driver runs under. This bounds virtual
# address space, so it must cover thread stacks and allocator mappings on top of
# the OS itself; 8 GiB is comfortable for ~128 threads.
export MEM_RESERVE_GIB="${MEM_RESERVE_GIB:-8}"
