# Site configuration for bench.sbatch and, last, for the query campaigns of
# benchmark/query/. Copy to `local.env`, which is untracked:
#
#   cp benchmark/local.env.example benchmark/local.env
#   . benchmark/local.env && sbatch benchmark/bench.sbatch
#
# Sourcing before `sbatch` matters for the SBATCH_* entries: those are read by
# sbatch itself at submit time and cannot be set from inside the job. The rest
# are picked up either way, since the jobs also source this file if present.

# Partition to submit to, and the node to pin to. Pinning to one node is a
# measurement requirement, not a convenience: wall-clock is not comparable
# across nodes, and summarize.py refuses to tabulate records that span hosts.
export SBATCH_PARTITION="${SBATCH_PARTITION:-}"
export SBATCH_NODELIST="${SBATCH_NODELIST:-}"

# Where campaign directories are created. Deliberately outside the repo: the old
# default was repo-relative, which made the results location depend on which
# directory sbatch happened to be run from.
export RESULTS_ROOT="${RESULTS_ROOT:-${HOME}/gpu-saca-results}"

# Holds <corpus>/<corpus>-<tokenizer>.tokenized.bin.
export CORPUS_ROOT="${CORPUS_ROOT:-/scratch/${USER:-$(id -un)}/corpora}"

# Colon-separated scratch roots for our method's disk backend. Required by
# --ours: the driver refuses to start without it, so leaving it unset turns every
# gpu_saca run into a bad_input record. Point it at node-local NVMe, not at a
# network filesystem -- the spill traffic is the point of the disk backend.
export GPU_SACA_SCRATCH="${GPU_SACA_SCRATCH:-}"

# Module names to load inside the job, space separated. Leave empty if the
# toolchain is already on PATH. A module-provided libgomp or libstdc++ lives
# outside the default loader path, so omitting a needed one shows up as a
# runtime linker failure after a clean build, not as a build error.
export MODULES="${MODULES-}"

# The query campaigns, benchmark/query/timed.sbatch and xcheck.sbatch, read
# RESULTS_ROOT and MODULES above, and the entries below. The rest of their
# settings, TM_* and XC_*, are a campaign's choices rather than the site's: each
# script's header lists them.

# infini-gram checkout at v2.6.0, the query baseline. The campaigns compile its
# engine from here instead of fetching it, so the checkout must be at that tag:
# a local source skips the commit benchmark/CMakeLists.txt pins. igbench.py
# builds infini-gram's indexes with its indexer from here, and checks the tag.
export INFINIGRAM_DIR="${INFINIGRAM_DIR:-${HOME}/infini-gram}"

# CUDA architecture of the campaigns' in-job builds: the benchmark node's GPU,
# e.g. 80-real for an A100, 90-real for an H100, 120-real for an RTX PRO 6000
# Blackwell.
export TM_ARCH="${TM_ARCH:-120-real}"
export XC_ARCH="${XC_ARCH:-120-real}"

# Extra configure arguments of those builds, e.g. -DFETCHCONTENT_SOURCE_DIR_*
# for the other dependencies on a node that cannot fetch them.
export TM_CMAKE_ARGS="${TM_CMAKE_ARGS:-}"
export XC_CMAKE_ARGS="${XC_CMAKE_ARGS:-}"

# Node-local directories to stage the indexes onto before the runs; `none`
# reads them in place. timed.sbatch stages by default; with the suffix array
# mapped, its runs time the drive it is read from, so point this at node-local
# NVMe. A node with more drives can hold the text apart (TM_TEXT_STAGE,
# XC_TEXT_STAGE), and a copy of the suffix array split over them (TM_STRIPE).
export TM_STAGE="${TM_STAGE:-/tmp/${USER:-$(id -un)}/query-stage}"
export XC_STAGE="${XC_STAGE:-none}"

# Pieces copied at a time when staging (benchmark/query/stage.sh): a single
# stream reads a shared filesystem at a fraction of what several do.
export STAGE_STREAMS="${STAGE_STREAMS:-16}"
